# VITE_OPENAI_API_KEY: Primary OpenAI API key.
VITE_OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# VITE_OPENAI_API_KEY_BACKUP: Backup OpenAI API key.
# If the primary key hits a quota/rate-limit error, the server will
# automatically retry the request with this key.
VITE_OPENAI_API_KEY_BACKUP="YOUR_BACKUP_OPENAI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Razorpay Configuration (Use test keys for testing, live keys for production)
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"  # Your Razorpay Key ID
RAZORPAY_KEY_SECRET="YOUR_KEY_SECRET"   # Your Razorpay Key Secret

# API Configuration
VITE_API_URL="http://localhost:3001/api"  # Backend API URL
VITE_API_KEY="candidjobs_iep_secure_key_2025"  # API key for payment endpoints
API_KEY="candidjobs_iep_secure_key_2025"  # Server-side API key
