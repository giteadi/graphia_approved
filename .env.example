# Server Port
PORT=3002

# OpenAI API Keys
OPENAI_API_KEY="sk-proj-YOUR_PRIMARY_KEY"
OPENAI_API_KEY_BACKUP="sk-proj-YOUR_BACKUP_KEY"

# JWT Authentication (generate a secure random 64-character secret)
JWT_SECRET="YOUR_RANDOM_JWT_SECRET_KEY"

# Admin Accounts (comma-separated list of emails with administrative privileges)
ADMIN_EMAILS="admin@graphiacheck.in,aditya@graphiacheck.in"

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=graphia

# Email Notification Configuration (Nodemailer SMTP)
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"

# Razorpay Configuration (Use test keys for development, live keys for production)
RAZORPAY_KEY_ID="rzp_live_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_KEY_SECRET"

# Razorpay Test Configuration (for accounts in TEST_PAYMENT_EMAILS)
RAZORPAY_TEST_KEY_ID="rzp_test_YOUR_TEST_KEY_ID"
RAZORPAY_TEST_KEY_SECRET="YOUR_TEST_KEY_SECRET"
TEST_PAYMENT_EMAILS="admin@graphiacheck.in,test@graphiacheck.in"

# Frontend / API Configuration
VITE_API_URL="https://graphiacheck.in/api"
API_KEY="your-secure-internal-api-key"
